# dh-app-api — local dev environment
# Copy to .env and fill in your values.

# ── Backend selector ──────────────────────────────────────────────────────────
# "postgres" for local dev, "hana" for BTP production
DH_DB_DRIVER=postgres

# ── PostgreSQL (local dev) ────────────────────────────────────────────────────
DH_DB_HOST=localhost
DH_DB_PORT=5432
DH_DB_NAME=dh_main_app
DH_DB_USER=postgres
DH_DB_PASSWORD=your_pg_password

# ── SAP HANA Cloud (BTP production) ──────────────────────────────────────────
# Used when DH_DB_DRIVER=hana
# DH_DB_HOST=your-hana-host.hanacloud.ondemand.com
# DH_DB_PORT=443
# DH_DB_USER=DBADMIN
# DH_DB_PASSWORD=your_hana_password

# ── App secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=change-me-local-dev
API_KEY=local-dev-key
ADMIN_EMAIL=your@email.com
